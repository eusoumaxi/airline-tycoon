{
  "name": "airline-tycoon-slots",
  "version": "1.0.0",
  "description": "Automatic slot optimizer for Airlines Manager (tycoon.airlines-manager.com)",
  "type": "module",
  "scripts": {
    "start": "bun run src/index.ts",
    "optimize": "bun run src/index.ts",
    "fetch": "bun run src/index.ts --fetch-only",
    "offline": "bun run src/index.ts --offline",
    "apply": "bun run src/apply.ts",
    "apply:live": "bun run src/apply.ts --apply"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.5.0"
  }
}
