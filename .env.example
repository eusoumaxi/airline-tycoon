# Session cookie from tycoon.airlines-manager.com
# DevTools → Network → any request → copy the Cookie header.
# REMEMBERME + PHPSESSID authenticate you. Never commit real values.
AM_COOKIE=

# Optional. Override if the game starts rejecting the default Chrome UA.
# AM_USER_AGENT=

# Optional. Hub codes `bun run apply` targets when you omit --hub.
# AM_APPLY_HUBS=LHR

# Optional. Output directory for JSON snapshots and HTML reports.
# AM_DATA_DIR=data

# Optional. Skip rental aircraft in the optimizer (1 = skip).
# AM_SKIP_RENTALS=
